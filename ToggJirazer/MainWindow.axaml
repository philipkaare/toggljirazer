<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ToggJirazer"
        x:Class="ToggJirazer.MainWindow"
        Title="ToggJirazer" Height="720" Width="760"
        MinHeight="600" MinWidth="640"
        Icon="/Assets/toggjirazer.ico">

    <Window.Styles>
        <Style Selector="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,4,0"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style Selector="CalendarDatePicker">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,4"/>
        </Style>
    </Window.Styles>

    <Grid Margin="12" RowDefinitions="Auto,Auto,*">

        <!-- Settings -->
        <TabControl Grid.Row="0" Margin="0,0,0,10">

            <!-- Toggl settings -->
            <TabItem Header="Toggl">
                <Grid Margin="10,8" ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <local:TogglSignInControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TogglSignIn"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Organization ID:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TogglOrgId"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Workspace ID:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TogglWorkspaceId"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Project ID:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="TogglProjectId"/>
                </Grid>
            </TabItem>

            <!-- Jira settings -->
            <TabItem Header="Jira">
                <local:AtlassianSignInControl x:Name="JiraSignIn" Margin="10,8"/>
            </TabItem>

            <!-- Report settings -->
            <TabItem Header="Report">
                <Grid Margin="10,8" ColumnDefinitions="160,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                    <Label Grid.Row="0" Grid.Column="0" Content="Start Date:"/>
                    <CalendarDatePicker Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ReportStartDate"
                                        SelectedDateFormat="Short"
                                        ToolTip.Tip="Leave empty to use the current month"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="End Date:"/>
                    <CalendarDatePicker Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ReportEndDate"
                                        SelectedDateFormat="Short"
                                        ToolTip.Tip="Leave empty to use the current month"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Output File:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReportOutputFile" Margin="0,3,4,3"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Click="BrowseOutputFile_Click"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Format:"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ReportFormat">
                        <ComboBoxItem Content="xlsx"/>
                        <ComboBoxItem Content="csv"/>
                    </ComboBox>
                </Grid>
            </TabItem>

            <!-- Email settings -->
            <TabItem Header="Email">
                <Grid Margin="10,8" ColumnDefinitions="160,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <Label Grid.Row="0" Grid.Column="0" Content="SMTP Host:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="EmailSmtpHost"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="SMTP Port:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="EmailSmtpPort"
                             ToolTip.Tip="587 for STARTTLS, 465 for implicit SSL"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Implicit SSL:"/>
                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="EmailUseSsl"
                              VerticalAlignment="Center" Margin="0,3"
                              ToolTip.Tip="Check for implicit SSL (port 465); uncheck for STARTTLS (port 587)."/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Username:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="EmailUsername"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Password:"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="EmailPassword" PasswordChar="●"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="From Address:"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="EmailFromAddress"/>

                    <Label Grid.Row="6" Grid.Column="0" Content="Recipients:"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="EmailRecipients"
                             ToolTip.Tip="Separate multiple addresses with semicolons"/>

                    <Label Grid.Row="7" Grid.Column="0" Content="Subject:"/>
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="EmailSubject"
                             ToolTip.Tip="{}{month} and {year} are replaced with the report month (Danish) and year"/>

                    <Label Grid.Row="8" Grid.Column="0" Content="Body:" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <TextBox Grid.Row="8" Grid.Column="1" x:Name="EmailBody"
                             Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             ToolTip.Tip="{}{month} and {year} are replaced with the report month (Danish) and year"/>

                    <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="SendEmailNowButton" Content="Send Report by Email Now"
                                Click="SendEmailNow_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Buttons and progress bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto">
            <Button Grid.Row="0" Grid.Column="0" x:Name="SetupButton"
                    Content="Setup…" Margin="0,0,8,0"
                    Click="Setup_Click"/>
            <Button Grid.Row="0" Grid.Column="1" x:Name="SaveButton"
                    Content="Save Settings" Margin="0,0,8,0"
                    Click="SaveSettings_Click"/>
            <Button Grid.Row="0" Grid.Column="2" x:Name="RunButton"
                    Content="Generate Report" Margin="0,0,8,0"
                    Click="RunButton_Click"/>
            <Button Grid.Row="0" Grid.Column="3" x:Name="OpenReportButton"
                    Content="Open Report" IsEnabled="False"
                    Click="OpenReport_Click"/>
            <!-- Visible only while the pre-run Atlassian sign-in waits for the browser. -->
            <Button Grid.Row="0" Grid.Column="4" x:Name="CancelSignInButton"
                    Content="Cancel sign-in" Margin="8,0,0,0" IsVisible="False"
                    Click="CancelSignIn_Click"/>

            <CheckBox Grid.Row="0" Grid.Column="5" x:Name="EnableCacheCheckBox"
                      Content="Cache requests (1 day)" IsChecked="True"
                      VerticalAlignment="Center" HorizontalAlignment="Right"
                      ToolTip.Tip="Reuse previously fetched Toggl/Jira data for up to 1 day instead of requesting it again."/>

            <ProgressBar Grid.Row="1" Grid.ColumnSpan="6"
                         x:Name="ProgressBar"
                         Height="20" Margin="0,8,0,0"
                         Minimum="0" Maximum="100" Value="0"/>
        </Grid>

        <!-- Log output -->
        <TextBox Grid.Row="2" x:Name="LogTextBox"
                 IsReadOnly="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas, Menlo, monospace"
                 FontSize="12"
                 AcceptsReturn="True"
                 VerticalContentAlignment="Top"
                 Background="#1E1E1E"
                 Foreground="#D4D4D4"
                 BorderBrush="#444444"/>
    </Grid>
</Window>
