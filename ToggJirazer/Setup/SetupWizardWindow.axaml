<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:steps="clr-namespace:ToggJirazer.Setup.Steps"
        x:Class="ToggJirazer.Setup.SetupWizardWindow"
        Title="ToggJirazer setup" Width="600" Height="460"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/toggjirazer.ico">

    <Window.Styles>
        <Style Selector="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,4,0"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,4"/>
        </Style>
        <Style Selector="HyperlinkButton">
            <Setter Property="Padding" Value="0,2"/>
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
    </Window.Styles>

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" x:Name="StepCounterText" Opacity="0.7" FontSize="12"/>
        <TextBlock Grid.Row="1" x:Name="StepTitleText" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,12"/>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <Panel>

                <!-- 1. Welcome (steps 2-6 are controls under Setup/Steps) -->
                <StackPanel x:Name="WelcomePanel">
                    <TextBlock TextWrapping="Wrap">
                        You need a Toggl account and an Atlassian account. The wizard signs you in to both,
                        lets you pick your Toggl project, Atlassian site and Jira fields, and chooses where
                        the report is saved. Your settings are saved when you click Finish.
                    </TextBlock>
                </StackPanel>

                <steps:TogglSignInStep x:Name="TogglSignInStep" IsVisible="False"/>
                <steps:TogglProjectStep x:Name="TogglProjectStep" IsVisible="False"/>
                <steps:JiraSignInStep x:Name="JiraSignInStep" IsVisible="False"/>
                <steps:JiraFieldsStep x:Name="JiraFieldsStep" IsVisible="False"/>
                <steps:ReportOutputStep x:Name="ReportOutputStep" IsVisible="False"/>

                <!-- 7. Done -->
                <StackPanel x:Name="DonePanel" IsVisible="False">
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" LineHeight="22"/>
                    <TextBlock Classes="note" Text="Click Finish to save these settings."/>
                </StackPanel>

            </Panel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="BackButton" Content="Back" Click="Back_Click"/>
            <Button x:Name="NextButton" Content="Next" Click="Next_Click"/>
            <Button x:Name="FinishButton" Content="Finish" IsVisible="False" Click="Finish_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
